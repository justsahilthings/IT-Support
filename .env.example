# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for OAuth callbacks and WhatsApp webhooks.
APP_URL="MY_APP_URL"

# JWT_SECRET: Signing secret for session authentication tokens.
JWT_SECRET="change-this-to-a-strong-random-secret"

# Microsoft Outlook OAuth 2.0 & Graph API Configuration (Optional)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Meta WhatsApp Business Cloud API Configuration (Optional)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_VERIFY_TOKEN=""
